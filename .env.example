# Copy this file to ".env" and fill in your own values.
# The ".env" file itself must NEVER be shared or committed to git (already in .gitignore).

# --- OpenRouter (required) ---
# Create an API key at https://openrouter.ai/keys -- see step 3 in SETUP.md.
OPENROUTER_API_KEY=sk-or-v1-paste-your-own-key-here

# Which language model is used. Default: a good balance between price and
# quality for Dutch text + structured output. See SETUP.md for
# alternatives (e.g. a free model to test with first).
OPENROUTER_MODEL=openrouter/free

# --- Gmail ---
# By default, the app expects credentials.json / token.json next to this file.
# Only change these if you want to store them elsewhere.
# GMAIL_CREDENTIALS_FILE=credentials.json
# GMAIL_TOKEN_FILE=token.json

# --- Safety ---
# Keep this set to "false" until you have reviewed and trust draft replies
# in Gmail for a while. When set to "true", the app sends replies
# fully automatically, without human review.
AUTO_SEND=false

# --- Optional: adjust labels & limits ---
# GMAIL_LABEL_HANDLED=AI_Processed
# GMAIL_LABEL_NEEDS_HUMAN=AI_Needs_Review
# GMAIL_MAX_RESULTS=10
# THREAD_CONTEXT_LIMIT=10
