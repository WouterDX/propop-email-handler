# Copy this file to ".env" and fill in your own values.
# The ".env" file itself must NEVER be shared or committed to git (already in .gitignore).

# --- OpenRouter (required) ---
# Create an API key at https://openrouter.ai/keys -- see step 3 in SETUP.md.
OPENROUTER_API_KEY=sk-or-v1-paste-your-own-key-here

# Which language model is used. Default: a good balance between price and
# quality for Dutch text + structured output. See SETUP.md for
# alternatives (e.g. a free model to test with first).
OPENROUTER_MODEL=openrouter/free

# A good practice is to set APP_NAME for openrouter to identify your app in their dashboard/rate limits. It can be any string.
OPENROUTER_APP_NAME=myorg-email-handler

# --- Gmail ---
# By default, the app expects credentials.json / token.json next to this file.
# Only change these if you want to store them elsewhere.
# GMAIL_CREDENTIALS_FILE=credentials.json
# GMAIL_TOKEN_FILE=token.json

# --- Company data file ---
# Copy data/company_data_example.json to data/company_data.json and fill in
# your real (non-anonymized) business data.
# COMPANY_DATA_FILE=data/company_data.json

# --- Safety ---
# Keep this set to "false" until you have reviewed and trust draft replies
# in Gmail for a while. When set to "true", the app sends replies
# fully automatically, without human review.
AUTO_SEND=false

# --- Optional: adjust labels & limits ---
# GMAIL_LABEL_HANDLED=AI_Processed
# GMAIL_LABEL_NEEDS_HUMAN=AI_Needs_Review
# Gmail query fragment defining where incoming emails are searched.
# This can be any Gmail query syntax (labels, categories, include/exclude, etc.).
# Example below excludes obvious system folders.
# INCOMING_MAIL_FOLDERS=-in:sent -in:spam -in:trash -in:drafts
# Comma-separated subject keywords used to pre-filter relevant emails.
# Keep empty to disable keyword filtering.
# GMAIL_SUBJECT_KEYWORDS=reservatie,reserveren
# GMAIL_MAX_RESULTS=10
# THREAD_CONTEXT_LIMIT=10

# if set to true, ignores interaction with reservation_list, useful when not implemented yet.
RESERVATION_LIST_STUB=true
